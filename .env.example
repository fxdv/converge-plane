# Circle — local development environment.
# Copy to .env and adjust. All variables are optional in dev except
# CIRCLE_DATABASE_URL.

# ---- Server -----------------------------------------------------------
CIRCLE_HTTP_ADDR=:3001
CIRCLE_DATABASE_URL=postgresql://circle:circle@localhost:5432/circle?sslmode=disable
CIRCLE_PUBLIC_URL=http://localhost:3001
CIRCLE_WEB_ORIGIN=http://localhost:3000
CIRCLE_LOG_LEVEL=debug
# CIRCLE_AUTO_MIGRATE=true
# CIRCLE_DB_MIN_CONNS=1
# CIRCLE_DB_MAX_CONNS=20

# ---- Web (baked into the client bundle at build/dev time) --------------
NEXT_PUBLIC_BACKEND_HOST=http://localhost:3001
NEXT_PUBLIC_BASE_HOST=http://localhost:3000
NEXT_PUBLIC_VERSION=0.1.0
NEXT_PUBLIC_NODE_ENV=development

# ---- Postgres (docker-compose) ------------------------------------------
POSTGRES_USER=circle
POSTGRES_PASSWORD=circle
POSTGRES_DB=circle
