# Converge — local development environment.
# Copy to .env and adjust. All variables are optional in dev except
# CONVERGE_DATABASE_URL. docker compose reads this file for ${VAR}
# expansion; see deploy/README.md for the production reference.

# ---- Server -----------------------------------------------------------
CONVERGE_HTTP_ADDR=:3001
CONVERGE_DATABASE_URL=postgresql://converge:converge@localhost:5432/converge?sslmode=disable
CONVERGE_PUBLIC_URL=http://localhost:3001
CONVERGE_WEB_ORIGIN=http://localhost:3000
CONVERGE_LOG_LEVEL=debug
# Dev conveniences: the sign-in response includes the magic link directly
# (local setups have no email provider). Never enable in production.
CONVERGE_DEV_MODE=true
# CONVERGE_AUTO_MIGRATE=true
# CONVERGE_HTTP_TIMEOUT=30s
# CONVERGE_DB_MIN_CONNS=2
# CONVERGE_DB_MAX_CONNS=20
# Secure cookies; set true when the deployment is behind TLS.
# CONVERGE_SECURE_COOKIES=false
# Signs session tokens. In real deployments set a long random value:
#   CONVERGE_SESSION_SECRET=$(openssl rand -hex 32)
CONVERGE_SESSION_SECRET=converge-dev-session-secret-do-not-use-in-prod
# CONVERGE_ACCESS_TOKEN_TTL=1h
# CONVERGE_REFRESH_TOKEN_TTL=720h
# Runtime override for the web container's /api proxy target (docker
# compose sets http://api:3001 automatically; only needed for unusual
# layouts). Must be reachable from the web container.
# API_PROXY_TARGET=http://localhost:3001

# ---- Web (baked into the client bundle at build/dev time) --------------
NEXT_PUBLIC_BACKEND_HOST=http://localhost:3001
NEXT_PUBLIC_BASE_HOST=http://localhost:3000
NEXT_PUBLIC_VERSION=0.1.0
NEXT_PUBLIC_NODE_ENV=development

# ---- Postgres (docker-compose) ------------------------------------------
POSTGRES_USER=converge
POSTGRES_PASSWORD=converge
POSTGRES_DB=converge
