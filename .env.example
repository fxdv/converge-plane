# Converge — local development environment.
# Copy to .env and adjust. All variables are optional in dev except
# CONVERGE_DATABASE_URL. docker compose reads this file for ${VAR}
# expansion; see deploy/README.md for the production reference.

# ---- Server -----------------------------------------------------------
CONVERGE_HTTP_ADDR=:3001
CONVERGE_DATABASE_URL=postgresql://converge:converge@localhost:5432/converge?sslmode=disable
CONVERGE_PUBLIC_URL=http://localhost:3001
# Browsers treat localhost and 127.0.0.1 as different origins; dev mode
# also trusts loopback names on this port (and tunnel IPs on the web port).
CONVERGE_WEB_ORIGIN=http://localhost:3000
CONVERGE_LOG_LEVEL=debug
# Dev conveniences: the sign-in response includes the magic link directly
# (local setups have no email provider). The API refuses to start in dev
# mode unless PUBLIC_URL and WEB_ORIGIN are localhost.
CONVERGE_DEV_MODE=true
# CONVERGE_AUTO_MIGRATE=true
# CONVERGE_HTTP_TIMEOUT=30s
# CONVERGE_DB_MIN_CONNS=2
# CONVERGE_DB_MAX_CONNS=20
# Unset = Secure cookies iff CONVERGE_WEB_ORIGIN is https.
# CONVERGE_SECURE_COOKIES=
# Signs session tokens. Optional in dev mode (a dev value is used);
# required (>= 32 chars) otherwise — the API refuses to start without it:
#   CONVERGE_SESSION_SECRET=$(openssl rand -hex 32)
# CONVERGE_SESSION_SECRET=
# Access tokens also bound how long a signed-out token survives a restart.
# CONVERGE_ACCESS_TOKEN_TTL=1h
# CONVERGE_REFRESH_TOKEN_TTL=720h
# Proxies whose X-Forwarded-For is believed (CIDRs/IPs, comma-separated;
# "none" = no proxy). Default: loopback + private ranges.
# CONVERGE_TRUSTED_PROXIES=
# Prometheus /metrics on its own listener; empty = off. Never expose it
# through the public proxy.
# CONVERGE_METRICS_ADDR=127.0.0.1:9464
# Sign-in and invitation mail. Unset host = log driver: recipient and
# subject are logged; the body (with the sign-in link) only in dev mode or
# with CONVERGE_MAIL_LOG_BODIES=true. Production needs SMTP for anyone to
# sign in.
# CONVERGE_MAIL_LOG_BODIES=
# CONVERGE_SMTP_HOST=smtp.example.com
# CONVERGE_SMTP_PORT=587
# CONVERGE_SMTP_USER=
# CONVERGE_SMTP_PASS=
# CONVERGE_SMTP_FROM=no-reply@converge.local
# CONVERGE_SMTP_TLS=starttls   # starttls | off | implicit
# Runtime override for the web container's /api proxy target (docker
# compose sets http://api:3001 automatically; only needed for unusual
# layouts). Must be reachable from the web container.
# API_PROXY_TARGET=http://localhost:3001

# ---- Web (baked into the client bundle at build/dev time) --------------
NEXT_PUBLIC_BACKEND_HOST=http://localhost:3001
NEXT_PUBLIC_BASE_HOST=http://localhost:3000
NEXT_PUBLIC_VERSION=0.1.0
NEXT_PUBLIC_NODE_ENV=development

# ---- Postgres (docker-compose) ------------------------------------------
POSTGRES_USER=converge
POSTGRES_PASSWORD=converge
POSTGRES_DB=converge

# ---- docker compose service selection -----------------------------------
# Runs the one-shot demo seeder (Acme workspace + demo@converge.dev) on
# `docker compose up`. Remove the line for a production database that
# should start empty (sign up via onboarding instead).
COMPOSE_PROFILES=seed
